rule Generic_G_Suspicious_Injector_A { meta: description="Remote process memory/thread API combination" category="injector" confidence="medium" strings: $a="OpenProcess" $b="VirtualAllocEx" $c="WriteProcessMemory" $d="CreateRemoteThread" condition: uint16(0)==0x5A4D and 3 of them }
rule Generic_G2_Suspicious_Injector_B { meta: description="Native process injection API combination" category="injector" confidence="medium" strings: $a="NtOpenProcess" $b="NtWriteVirtualMemory" $c="NtCreateThreadEx" $d="RtlCreateUserThread" condition: uint16(0)==0x5A4D and 2 of them }
rule Generic_G3_Suspicious_Injector_C { meta: description="DLL injection and remote loader indicators" category="injector" confidence="low" strings: $a="LoadLibraryA" $b="LoadLibraryW" $c="GetProcAddress" $d="CreateRemoteThread" condition: uint16(0)==0x5A4D and 3 of them }
rule Generic_G4_Suspicious_Injector_D { meta: description="Manual map/reflective injection indicators" category="injector" confidence="low" strings: $a="ManualMap" nocase $b="ReflectiveLoader" nocase $c="ProcessHollowing" nocase $d="QueueUserAPC" condition: uint16(0)==0x5A4D and 2 of them }
