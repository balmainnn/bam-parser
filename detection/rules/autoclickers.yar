rule Generic_A_Autoclicker_Basic { meta: description="Basic autoclicker strings" category="autoclicker" confidence="low" strings: $a="click interval" nocase $b="clicker" nocase $c="leftclick" nocase $d="rightclick" nocase $e="start clicking" nocase condition: uint16(0)==0x5A4D and 2 of them }
rule Generic_A2_Autoclicker_API { meta: description="Mouse injection API plus click automation indicators" category="autoclicker" confidence="medium" strings: $a="mouse_event" $b="SendInput" $c="SetCursorPos" $d="click interval" nocase $e="cps" nocase $f="auto click" nocase condition: uint16(0)==0x5A4D and 1 of ($a,$b,$c) and 1 of ($d,$e,$f) }
rule Generic_A3_CSharp_Autoclicker { meta: description="C# mouse automation indicators" category="autoclicker" confidence="low" strings: $net="mscoree.dll" $a="System.Windows.Forms" $b="SendWait" $c="MouseButtons" $d="clickDelay" nocase condition: uint16(0)==0x5A4D and $net and 2 of ($a,$b,$c,$d) }
